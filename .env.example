# .env.example — copy to .env and fill in real values tonight.
# NEVER commit a real .env, and NEVER put a real key in this file.
# The skeleton ships NO real values; every variable below is empty on
# purpose. Missing variables fail loudly with a clear message (see
# README § "Tonight" and app/_layout.tsx).

# Convex deployment URL (public to the app bundle — it is a URL, not a
# secret). From the Convex dashboard after creating the free project.
# The app shows a setup screen until this is set.
EXPO_PUBLIC_CONVEX_URL=

# Supabase project URL (public to the app bundle — it is a URL, not a
# secret). Set in the CONVEX dashboard (not in the app) as
# SUPABASE_URL, so the runAi action can call the Edge Function.
# The same value is listed here so the team has one place to copy from.
SUPABASE_URL=

# Supabase anon key (public to the app bundle — it is a publishable
# key, not a secret). Set in the CONVEX dashboard as
# SUPABASE_ANON_KEY. The Edge Function requires it as a Bearer token.
SUPABASE_ANON_KEY=

# Gemini API key — SERVER-SIDE ONLY. Never EXPO_PUBLIC_, never in the
# app bundle, never in code. Set ONLY as a Supabase function secret:
#   supabase secrets set GEMINI_API_KEY=<key> --project-ref <REF>
# Until it is set, the Edge Function answers 503 and the app runs in
# stub mode (canned 3-step answers, labelled STUBBED).
GEMINI_API_KEY=
